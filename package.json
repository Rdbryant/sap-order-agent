{
  "name": "sap-order-agent",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/mcp": "^1.5.0",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^10.0.0",
    "@sap/cds-dk": "^10.1.0",
    "eslint": "^10.11.0"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --test",
    "lint": "eslint .",
    "watch": "cds watch",
    "mcp:card": "cds compile srv -2 mcp"
  },
  "private": true,
  "cds": {
    "mcp": {
      "per_action_tool": true
    },
    "[development]": {
      "app": {
        "asOfDate": "2026-09-30"
      },
      "requires": {
        "auth": {
          "kind": "mocked",
          "users": {
            "*": false,
            "alice": {
              "roles": [
                "OrderViewer"
              ]
            },
            "bob": {
              "roles": []
            }
          }
        }
      }
    },
    "[test]": {
      "app": {
        "asOfDate": "2026-09-30"
      },
      "requires": {
        "auth": {
          "kind": "mocked",
          "users": {
            "*": false,
            "alice": {
              "roles": [
                "OrderViewer"
              ]
            },
            "bob": {
              "roles": []
            }
          }
        }
      }
    }
  },
  "description": "Read-only order status agent built with SAP CAP and exposed to AI assistants over MCP (demo project, fictional data)"
}
